@base = http://localhost:3000/api
@token = PEGAR_TOKEN_AQUI

### Listar conductores
GET {{base}}/conductores
Authorization: Bearer {{token}}

### Crear conductor
POST {{base}}/conductores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Juan", "apellido": "Pérez", "numero_documento": "30123456",
  "numero_licencia": "LIC-998877", "fecha_alta_licencia": "2018-03-10",
  "fecha_vencimiento_licencia": "2028-03-10"
}

### Actualizar conductor
PUT {{base}}/conductores/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Juan", "apellido": "Pérez", "numero_documento": "30123456",
  "numero_licencia": "LIC-998877", "fecha_alta_licencia": "2018-03-10",
  "fecha_vencimiento_licencia": "2030-03-10"
}

### Eliminar conductor
DELETE {{base}}/conductores/1
Authorization: Bearer {{token}}
